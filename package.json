{
  "name": "eslint-plugin-between",
  "version": "0.0.1",
  "description": "ESLint plugin that checks inclusive TypeScript numeric ranges, arithmetic, and function contracts.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "compile": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "compile:watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run compile && node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm test",
    "build": "npm run check",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelmenov/typescript-between-type-plugin.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "typescript",
    "between",
    "range"
  ],
  "author": "Alex Elmenov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aelmenov/typescript-between-type-plugin/issues"
  },
  "homepage": "https://github.com/aelmenov/typescript-between-type-plugin#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/rule-tester": "^8.71.0",
    "eslint": "^10.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./types": "./lib.between.d.ts"
  },
  "files": [
    "lib",
    "lib.between.d.ts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.71.0"
  },
  "typesVersions": {
    "*": {
      "types": [
        "lib.between.d.ts"
      ]
    }
  }
}
