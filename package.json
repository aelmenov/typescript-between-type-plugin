{
  "name": "@elmenov-softworks/eslint-plugin-between",
  "version": "1.0.1",
  "description": "ESLint plugin that checks inclusive TypeScript numeric ranges, arithmetic, and function contracts.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "typescript",
    "between",
    "range"
  ],
  "author": "Alex Elmenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elmenov-softworks/eslint-plugin-between.git"
  },
  "bugs": {
    "url": "https://github.com/elmenov-softworks/eslint-plugin-between/issues"
  },
  "homepage": "https://github.com/elmenov-softworks/eslint-plugin-between#readme",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./types": "./lib.between.d.ts"
  },
  "typesVersions": {
    "*": {
      "types": [
        "lib.between.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "lib",
    "lib.between.d.ts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "compile:watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run compile && npm run test:typecheck && npm run test:run --",
    "test:run": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "config:typecheck": "tsc -p tsconfig.configs.json",
    "benchmark": "npm run compile && node --import tsx scripts/benchmark.ts",
    "check": "npm run compile && npm run format:check && npm run lint && npm run config:typecheck && npm run test:typecheck && npm run test:run",
    "build": "npm run compile",
    "prepack": "npm run check",
    "format": "node --import tsx node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node --import tsx node_modules/prettier/bin/prettier.cjs --check .",
    "version": "node --import tsx scripts/version.ts"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.71.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/types": "^30.5.1",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "type-fest": "^4.41.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0"
  }
}
